<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="LiTo381Launcher.app" />
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <!-- Keep the user-facing control panel at normal integrity.  The
             isolated LiTo runtime is launched with the Windows RunAsInvoker
             compatibility layer; it only edits its own child and loopback
             workspace, so no administrator-wide permission is required. -->
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <supportedOS Id="{4f476546-9374-4f89-81c1-93ec3f6f0507}" />
    </application>
  </compatibility>
</assembly>
