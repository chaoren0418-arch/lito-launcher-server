<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>LiTo381Launcher</AssemblyName>
    <RootNamespace>LiTo381Launcher</RootNamespace>
    <Version>0.6.71</Version>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="obj\**;bin\**" />
    <Content Include="development_startup.py" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- T140 / Issue #404: acceptance-only helper for the external-server-profile option. -->
    <Content Include="external_server_startup.py" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <InternalsVisibleTo Include="LiTo381Launcher.Tests" />
    <Content Include="..\server-profiles\*.json"
             Link="server-profiles\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>
