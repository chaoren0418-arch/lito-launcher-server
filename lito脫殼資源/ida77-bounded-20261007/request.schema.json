{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IDA77 bounded fixture request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source_path",
    "source_sha256",
    "image_base",
    "functions",
    "authorization_scope"
  ],
  "properties": {
    "schema": {
      "const": "ida77-bounded-request-v1"
    },
    "source_path": {
      "type": "string"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "image_base": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "authorization_scope": {
      "const": "synthetic_tool_fixture_only"
    },
    "functions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rva",
          "end_rva"
        ],
        "properties": {
          "rva": {
            "type": "integer",
            "minimum": 0,
            "maximum": 67108864
          },
          "end_rva": {
            "type": "integer",
            "minimum": 0,
            "maximum": 67108864
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "max_functions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "max_function_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "max_instructions_per_function": {
          "type": "integer",
          "minimum": 1,
          "maximum": 512
        },
        "max_xrefs_per_function": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "max_pseudocode_chars": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        },
        "max_output_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 262144
        },
        "max_job_disk_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        }
      }
    }
  },
  "description": "Semantic SHA, PE32, ranges and authorization checks are mandatory in ida77_request.py; JSON schema alone does not authorize launch."
}