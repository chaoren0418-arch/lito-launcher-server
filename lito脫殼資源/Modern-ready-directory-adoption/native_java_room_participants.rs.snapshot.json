      "text": "#[derive(Clone, Debug, PartialEq, Eq)] pub enum Change {Added, IgnoredDuplicateRow, StateUpdated, IgnoredUnknownAlias, IgnoredAmbiguousAlias, DepartureRemoved{rows:usize}, DepartureAbsentNoop, IgnoredDepartureOtherRoom, IgnoredUnqualifiedDeparture, IgnoredOwnDepartureWithoutCompletedIntent,OwnerUpdated{link:super::java_room_tail::OwnerLink},IgnoredOwnerOtherRoom,SelfExitNotification{write_serial:u64}}"
