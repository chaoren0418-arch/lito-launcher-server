    {
      "line": 103,
      "text": "        ensure!(self.key.origin==Origin::JoinedCeReceipt && self.key.ce_revision==Some(runtime.java_room.key.revision) && runtime.java_room.key.room.as_ref().is_some_and(|r|r.id==self.key.room_id) && runtime.java_room.key.phase==super::java_room_entry::Phase::RoomReceipts,\"retired joined catalog invalidation\");"
