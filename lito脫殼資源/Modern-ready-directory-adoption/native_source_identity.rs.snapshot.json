  "implementation_lines": [
    {
      "line": 1,
      "text": "//! Ordinary Native roster producer: opcode3 -> count, opcode203 -> record,"
    },
    {
      "line": 2,
      "text": "//! then a selected 0..3 control -> raw actor alias and separate +5C bound."
    },
    {
      "line": 3,
      "text": "//! No ModernCharacterSummary conversion, caller-supplied record or actor ID."
    },
    {
      "line": 4,
      "text": "//! Native AFBC/AFBD alternate branches and actor205 replacement remain OPEN."
    },
    {
      "line": 5,
      "text": "use anyhow::{ensure, Context, Result};"
    },
    {
      "line": 6,
      "text": ""
    },
    {
      "line": 7,
      "text": "pub const SLOT_COUNT: usize = 4;"
    },
    {
      "line": 8,
      "text": "pub const JAVA_ROW_BOUND:usize=8;"
    },
    {
      "line": 9,
      "text": "#[path=\"native_character_directory_fields.rs\"]pub mod fields;"
    },
    {
      "line": 10,
      "text": "const FORMAT: &[u8] = b\"sscchhhcccccccccddddddddddcdddddc\";"
    },
    {
      "line": 11,
      "text": "const OFFSETS: [usize; 30] = [0x2d,0x2e,0x30,0x32,0x34,0x36,0x37,0x38,0x39,0x3a,0x3b,0x3c,0x3d,0x3e,0x40,0x48,0x44,0x4c,0x50,0x54,0x58,0x60,0x64,0x68,0x5c,0x84,0x80,0x88,0x8c,0x90];"
    },
    {
      "line": 12,
      "text": ""
    },
    {
      "line": 13,
      "text": "#[derive(Clone, Debug, PartialEq, Eq)]"
    },
    {
      "line": 14,
      "text": "pub struct Record { bytes: [u8; 180], opcode_write_byte: u8, fields:fields::Fields }"
    },
    {
      "line": 15,
      "text": "impl Record {"
    },
    {
      "line": 16,
      "text": "    pub fn fields(&self)->&fields::Fields{&self.fields}"
    },
    {
      "line": 17,
      "text": "    pub fn clan_name(&self)->&[u8]{let n=self.bytes[0x1c..0x2d].iter().position(|b|*b==0).unwrap();&self.bytes[0x1c..0x1c+n]}"
    },
    {
      "line": 18,
      "text": "    pub fn display_name(&self)->Result<String>{fields::display_ms950(self.name())}"
    },
    {
      "line": 19,
      "text": "    pub fn name(&self) -> &[u8] { let n=self.bytes[..28].iter().position(|b|*b==0).unwrap(); &self.bytes[..n] }"
    },
    {
      "line": 20,
      "text": "    pub fn class_byte(&self) -> u8 { self.bytes[0x2d] }"
    },
    {
      "line": 21,
      "text": "    pub fn variant_byte(&self) -> u8 { self.bytes[0x2e] }"
    },
    {
      "line": 22,
      "text": "    pub fn selection_guard_byte(&self) -> u8 { self.bytes[0x37] }"
    },
    {
      "line": 23,
      "text": "    pub fn arena_bound_byte(&self) -> u8 { self.bytes[0x5c] }"
    },
    {
      "line": 24,
      "text": "    /// Field32 writes the saved incoming ESI (the opcode address), NOT +94."
    },
    {
      "line": 25,
      "text": "    /// Modern keeps the immutable event; no caller memory is modified."
    },
    {
      "line": 26,
      "text": "    pub fn opcode_write_byte(&self) -> u8 { self.opcode_write_byte }"
    },
    {
      "line": 27,
      "text": "}"
    },
    {
      "line": 28,
      "text": ""
    },
    {
      "line": 29,
      "text": "#[derive(Clone, Debug, PartialEq, Eq)]"
    },
    {
      "line": 30,
      "text": "pub struct SelectedIdentity { slot: usize, actor_alias: Vec<u8>, class_byte: u8, variant_byte: u8, arena_bound_byte: u8 }"
    },
    {
      "line": 31,
      "text": "impl SelectedIdentity {"
    },
    {
      "line": 32,
      "text": "    pub fn slot(&self)->usize { self.slot }"
    },
    {
      "line": 33,
      "text": "    pub fn actor_alias(&self)->&[u8] { &self.actor_alias }"
    },
    {
      "line": 34,
      "text": "    pub fn class_byte(&self)->u8 { self.class_byte }"
    },
    {
      "line": 35,
      "text": "    pub fn variant_byte(&self)->u8 { self.variant_byte }"
    },
    {
      "line": 36,
      "text": "    pub fn arena_bound_byte(&self)->u8 { self.arena_bound_byte }"
    },
    {
      "line": 37,
      "text": "    /// This alias comes from selected roster record ->64ABF8. Actor205 has"
    },
    {
      "line": 38,
      "text": "    /// not yet been admitted; no identifier may be borrowed from mode206."
    },
    {
      "line": 39,
      "text": "    pub fn actor_identifier(&self)->Option<u32> { None }"
    },
    {
      "line": 40,
      "text": "}"
    },
    {
      "line": 41,
      "text": ""
    },
    {
      "line": 42,
      "text": "pub(crate) enum Packet { Start(u8), Record(Record) }"
    },
    {
      "line": 43,
      "text": "struct Reader<'a> { body: &'a [u8], at: usize }"
    },
    {
      "line": 44,
      "text": "impl Reader<'_> {"
    },
    {
      "line": 45,
      "text": "    fn take(&mut self,n:usize)->Result<&[u8]> { let end=self.at.checked_add(n).context(\"roster offset overflow\")?;let b=self.body.get(self.at..end).context(\"short Native roster body\")?;self.at=end;Ok(b) }"
    },
    {
      "line": 46,
      "text": "    fn string(&mut self,cap:usize)->Result<&[u8]> {"
    },
    {
      "line": 47,
      "text": "        let rest=&self.body[self.at..];let n=rest.iter().take(cap).position(|b|*b==0).context(\"roster string exceeds NUL capacity\")?;self.take(n+1)"
    },
    {
      "line": 48,
      "text": "    }"
    },
    {
      "line": 49,
      "text": "}"
    },
    {
      "line": 50,
      "text": "pub(crate) fn decode(body:&[u8])->Result<Packet> {"
    },
    {
      "line": 51,
      "text": "    ensure!(body.len()<=155,\"Native roster body exceeds bound\");"
    },
    {
      "line": 52,
      "text": "    if body.first()==Some(&3) { ensure!(body.len()==2 && (body[1] as i8)>=0 && usize::from(body[1])<=JAVA_ROW_BOUND,\"roster count outside bounded signed-byte rows\");return Ok(Packet::Start(body[1])); }"
    },
    {
      "line": 53,
      "text": "    ensure!(body.first()==Some(&203),\"not a Native roster body\");"
    },
    {
      "line": 54,
      "text": "    let mut r=Reader{body,at:1};let mut bytes=[0;180];"
    },
    {
      "line": 55,
      "text": "    for (offset,cap) in [(0,28),(0x1c,17)] { let s=r.string(cap)?;bytes[offset..offset+s.len()].copy_from_slice(s); }"
    },
    {
      "line": 56,
      "text": "    let suffix=r.at;"
    },
    {
      "line": 57,
      "text": "    for (code,offset) in FORMAT[2..32].iter().zip(OFFSETS) {"
    },
    {
      "line": 58,
      "text": "        let n=match code { b'c'=>1,b'h'=>2,b'd'=>4,_=>unreachable!() };let b=r.take(n)?;bytes[offset..offset+n].copy_from_slice(b);"
    },
    {
      "line": 59,
      "text": "    }"
    },
    {
      "line": 60,
      "text": "    let opcode_write_byte=r.take(1)?[0];ensure!(r.at==body.len(),\"trailing Native roster bytes\");"
    },
    {
      "line": 61,
      "text": "    let fields=fields::Fields::decode(&body[suffix..])?;"
    },
    {
      "line": 62,
      "text": "    Ok(Packet::Record(Record{bytes,opcode_write_byte,fields}))"
    },
    {
      "line": 63,
      "text": "}"
    },
    {
      "line": 64,
      "text": ""
    },
    {
      "line": 65,
      "text": "#[derive(Clone, Copy, Debug, PartialEq, Eq)]"
    },
    {
      "line": 66,
      "text": "pub enum Change { Started { count: u8 }, Appended { slot: usize, complete: bool } }"
    },
    {
      "line": 67,
      "text": "#[derive(Clone, Debug, Default, PartialEq, Eq)]"
    },
    {
      "line": 68,
      "text": "pub struct State { expected: Option<u8>, records: Vec<Record>, selected: Option<SelectedIdentity>, complete: bool }"
    },
    {
      "line": 69,
      "text": "impl State {"
    },
    {
      "line": 70,
      "text": "    pub fn records(&self)->&[Record] { &self.records }"
    },
    {
      "line": 71,
      "text": "    pub fn selected(&self)->Option<&SelectedIdentity> { self.selected.as_ref() }"
    },
    {
      "line": 72,
      "text": "    pub fn complete(&self)->bool { self.complete }"
    },
    {
      "line": 73,
      "text": "    pub fn expected(&self)->Option<u8> { self.expected }"
    },
    {
      "line": 74,
      "text": "    pub(crate) fn prepare_packet(&self,body:&[u8])->Result<(Self,Change)> {"
    },
    {
      "line": 75,
      "text": "        let packet=decode(body)?;let mut next=self.clone();"
    },
    {
      "line": 76,
      "text": "        let change=match packet {"
    },
    {
      "line": 77,
      "text": "            Packet::Start(count)=> { next=Self{expected:Some(count),complete:count==0,..Self::default()};Change::Started{count} }"
    },
    {
      "line": 78,
      "text": "            Packet::Record(record)=> { let count=next.expected.context(\"roster203 before count3\")?;ensure!(!next.complete && next.records.len()<usize::from(count),\"unsolicited or excess roster203\");let slot=next.records.len();next.records.push(record);next.complete=next.records.len()==usize::from(count);Change::Appended{slot,complete:next.complete} }"
    },
    {
      "line": 79,
      "text": "        };Ok((next,change))"
    },
    {
      "line": 80,
      "text": "    }"
    },
    {
      "line": 81,
      "text": "    ///NativeBack retains raw62FAA0 roster bytes;Modern retireslogicalselected binding."
    },
    {
      "line": 82,
      "text": "    pub(crate) fn without_selected(&self)->Self{let mut next=self.clone();next.selected=None;next}"
    },
    {
      "line": 83,
      "text": "    pub(crate) fn prepare_select(&self,slot:usize)->Result<Self> {"
    },
    {
      "line": 84,
      "text": "        self.prepare_select_bounded(slot,SLOT_COUNT)"
    },
    {
      "line": 85,
      "text": "    }"
    },
    {
      "line": 86,
      "text": "    pub(crate) fn prepare_select_bounded(&self,slot:usize,bound:usize)->Result<Self> {"
    },
    {
      "line": 87,
      "text": "        ensure!(self.complete && slot<bound&&bound<=JAVA_ROW_BOUND,\"roster selection not ready\");let r=self.records.get(slot).context(\"unreceived roster slot\")?;"
    },
    {
      "line": 88,
      "text": "        ensure!(r.class_byte()!=255 && r.variant_byte()!=255 && r.selection_guard_byte()!=0,\"Native selected record refused\");"
    },
    {
      "line": 89,
      "text": "        let mut next=self.clone();next.selected=Some(SelectedIdentity{slot,actor_alias:r.name().to_vec(),class_byte:r.class_byte(),variant_byte:r.variant_byte(),arena_bound_byte:r.arena_bound_byte()});Ok(next)"
    },
    {
      "line": 90,
      "text": "    }"
    },
    {
      "line": 91,
      "text": "}"
    }
  ],
