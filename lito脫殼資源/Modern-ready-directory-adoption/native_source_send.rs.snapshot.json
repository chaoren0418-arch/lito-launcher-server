      "line": 52,
      "text": " fn prepare_body(&self,mut body:Vec<u8>)->Result<Prepared>{"
    },
    {
      "line": 53,
      "text": "  ensure!(self.pending.is_none(),\"source write still pending\");let before=self.counter.context(\"source1/d send seed absent\")?;let next=self.next.checked_add(1).context(\"source write serial exhausted\")?;"
    },
    {
      "line": 54,
      "text": "  let after=advance_counter(before,body.len())?;let key=before.to_le_bytes();let mut previous=0;"
    },
    {
      "line": 55,
      "text": "  for(i,b)in body.iter_mut().enumerate(){*b^=key[i&7]^previous;previous=*b;}"
    },
    {
      "line": 56,
      "text": "  let mut frame=((body.len()+2)as u16).to_le_bytes().to_vec();frame.extend(body);"
    },
    {
      "line": 57,
      "text": "  let ticket=Ticket{owner:self.owner.clone(),serial:self.next};let reservation=Reservation{ticket:ticket.clone(),counter_step:CounterStep{before,after},frame_bytes:frame.len()};"
    },
    {
      "line": 58,
      "text": "  Ok(Prepared{counter:after,next,pending:Pending{ticket,frame:frame.into(),offset:0,life:Arc::new(AtomicBool::new(true)),position:Arc::new(AtomicUsize::new(0))},reservation})"
    },
    {
      "line": 59,
      "text": " }"
    },
    {
      "line": 60,
      "text": " pub(crate) fn commit(&mut self,prepared:Prepared)->Reservation{self.counter=Some(prepared.counter);self.next=prepared.next;self.pending=Some(prepared.pending);prepared.reservation}"
    },
    {
      "line": 61,
      "text": " fn pending(&self,ticket:&Ticket)->Result<&Pending>{let p=self.pending.as_ref().context(\"source write is not pending\")?;ensure!(Arc::ptr_eq(&self.owner,&ticket.owner)&&p.ticket.serial==ticket.serial,\"retired or foreign source write ticket\");Ok(p)}"
    },
    {
      "line": 62,
      "text": " pub(crate) fn view(&self,ticket:&Ticket)->Result<WriteView>{let p=self.pending(ticket)?;Ok(WriteView{frame:p.frame.clone(),offset:p.offset,life:p.life.clone(),position:p.position.clone()})}"
    },
    {
      "line": 63,
      "text": " pub(crate) fn report(&mut self,ticket:&Ticket,expected_offset:usize,outcome:WriteOutcome)->Result<Progress>{"
    },
    {
      "line": 64,
      "text": "  let p=self.pending(ticket)?;ensure!(p.offset==expected_offset,\"stale source write offset\");let remaining=p.frame.len()-p.offset;"
    },
    {
      "line": 65,
      "text": "  let terminal=match outcome {WriteOutcome::Written(0)=>Some(Terminal::ZeroWrite),WriteOutcome::Written(n)if n>remaining=>Some(Terminal::OverWrite),WriteOutcome::Failed=>Some(Terminal::Failed),WriteOutcome::WouldBlock=>Some(Terminal::UnsupportedSpecialWrite),_=>None};"
    },
    {
      "line": 66,
      "text": "  if let Some(reason)=terminal{return Ok(Progress::Retired{reason,before:self.snapshot()});}"
    },
    {
      "line": 67,
      "text": "  let WriteOutcome::Written(n)=outcome else{unreachable!()};"
    },
    {
      "line": 68,
      "text": "  let p=self.pending.as_mut().unwrap();p.offset+=n;p.position.store(p.offset,Ordering::Release);"
    },
    {
      "line": 69,
      "text": "  if p.offset==p.frame.len(){self.pending.take();Ok(Progress::Complete)}else{Ok(Progress::Partial{offset:p.offset,remaining:p.frame.len()-p.offset})}"
