      "text": "    fn take(&mut self, n: usize) -> Result<&[u8]> { let end=self.at.checked_add(n).context(\"room offset overflow\")?; let v=self.body.get(self.at..end).context(\"short room result field\")?; self.at=end; Ok(v) }"
