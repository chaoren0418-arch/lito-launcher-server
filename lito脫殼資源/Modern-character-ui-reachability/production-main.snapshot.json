      "text": "fn run() -> Result<i32> {"
    },
    {
      "line": 80,
      "text": "    let args = std::env::args_os().collect::<Vec<_>>();"
    },
    {
      "line": 81,
      "text": "    let selected = match route(&args)? {"
    },
    {
      "line": 82,
      "text": "        Route::Version => {"
    },
    {
      "line": 83,
      "text": "            // A read-only, bounded diagnostic: no profile selection, resources,"
    },
