      "line": 89,
      "text": "            let report = modern_lito::session::profile_probe::run(&path);"
    },
    {
      "line": 90,
      "text": "            let code = if report[\"success\"] == true { 0 } else { 2 };"
    },
    {
      "line": 91,
      "text": "            println!(\"{report}\");"
    },
    {
      "line": 92,
