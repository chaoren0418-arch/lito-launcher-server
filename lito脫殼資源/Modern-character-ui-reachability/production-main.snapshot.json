    },
    {
      "line": 135,
      "text": "        Route::Help => {"
    },
    {
      "line": 136,
      "text": "            message(\"直接開啟會選擇 LiTo 設定檔。亦可使用 --profile <絕對路徑>。\\n設定格式決定協定：schema1 沿用 v37；schema2 必須明確選用 modern_v47，並連線至相容伺服器。\\n--version 提供不連線的版本資訊。\\n--probe-profile <絕對路徑> 檢查 TLS／協定後關閉，不登入、不查資料庫或資源；輸出 JSON，成功 exit 0，失敗 exit 2。\\n此程式不啟動 TW、原生 LiTo.bin 或 LHZ。\", false);"
    },
    {
      "line": 137,
      "text": "            None"
    },
    {
      "line": 138,
      "text": "        }"
    },
