      "line": 141,
      "text": "        let profile = ModernProfile::load(&path)?;"
    },
    {
      "line": 142,
      "text": "        // The validated profile selects the contract in Debug and Release."
    },
    {
      "line": 143,
      "text": "        // Old schema1 stays on v37; schema2 is an explicit, non-fallback v47."
    },
    {
      "line": 144,
      "text": "        let controller = modern_lito::session::SessionController::new(profile.clone());"
