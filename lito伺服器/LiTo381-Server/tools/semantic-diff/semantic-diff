#!/usr/bin/env bash
# semantic-diff --left A.jar --right B.jar [--classes spec] --json out.json --md out.md
set -euo pipefail
ROOT="$(cd "$(dirname "$0")" && pwd)"
ASM_VERSION="9.7"
ASM_SHA256_ASM="adf46d5e34940bdf148ecdd26a9ee8eea94496a72034ff7141066b3eea5c4e9d"
ASM_SHA256_TREE="62f4b3bc436045c1acb5c3ba2d8ec556ec3369093d7f5d06c747eb04b56d52b1"

download_asm() {
  mkdir -p "$ROOT/lib"
  for art in asm asm-tree; do
    local jar="$ROOT/lib/${art}-${ASM_VERSION}.jar"
    if [[ ! -f "$jar" ]]; then
      curl -fsSL -o "$jar" \
        "https://repo1.maven.org/maven2/org/ow2/asm/${art}/${ASM_VERSION}/${art}-${ASM_VERSION}.jar"
    fi
  done
  echo "${ASM_SHA256_ASM}  $ROOT/lib/asm-${ASM_VERSION}.jar" | sha256sum -c -
  echo "${ASM_SHA256_TREE}  $ROOT/lib/asm-tree-${ASM_VERSION}.jar" | sha256sum -c -
}

build_with_javac() {
  download_asm
  mkdir -p "$ROOT/target/classes"
  local srcs
  mapfile -t srcs < <(find "$ROOT/src/main/java" -name '*.java' | sort)
  javac --release 17 -encoding UTF-8 \
    -cp "$ROOT/lib/asm-${ASM_VERSION}.jar:$ROOT/lib/asm-tree-${ASM_VERSION}.jar" \
    -d "$ROOT/target/classes" \
    "${srcs[@]}"
}

ensure_built() {
  if [[ -f "$ROOT/target/semantic-diff.jar" && -d "$ROOT/target/dependency" ]]; then
    return
  fi
  if [[ -f "$ROOT/target/classes/local/lito381/semanticdiff/SemanticDiff.class" ]]; then
    return
  fi
  if command -v mvn >/dev/null 2>&1; then
    mvn -f "$ROOT/pom.xml" -q -DskipTests package \
      org.apache.maven.plugins:maven-dependency-plugin:3.6.1:copy-dependencies \
      -DoutputDirectory="$ROOT/target/dependency" \
      -DincludeScope=runtime
    return
  fi
  build_with_javac
}

append_jars() {
  local dir="$1"
  local cp="$2"
  local jar
  if [[ -d "$dir" ]]; then
    for jar in "$dir"/*.jar; do
      [[ -f "$jar" ]] || continue
      cp+=":$jar"
    done
  fi
  printf '%s' "$cp"
}

classpath() {
  if [[ -f "$ROOT/target/semantic-diff.jar" ]]; then
    local cp="$ROOT/target/semantic-diff.jar"
    if [[ -d "$ROOT/target/dependency" ]]; then
      cp="$(append_jars "$ROOT/target/dependency" "$cp")"
    else
      cp="$(append_jars "$ROOT/lib" "$cp")"
    fi
    printf '%s' "$cp"
    return
  fi
  download_asm
  printf '%s' "$ROOT/target/classes:$ROOT/lib/asm-${ASM_VERSION}.jar:$ROOT/lib/asm-tree-${ASM_VERSION}.jar"
}

ensure_built
CP="$(classpath)"
exec java -cp "$CP" local.lito381.semanticdiff.SemanticDiff "$@"
