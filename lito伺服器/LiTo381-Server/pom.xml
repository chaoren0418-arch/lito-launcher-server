<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>local.lito381</groupId>
    <artifactId>lito381-server</artifactId>
    <version>0.6.71</version>
    <name>LiTo 3.81C local arena server</name>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>
        <!-- T126 / Issue #357：可重現封裝。固定 JAR 內所有 entry 的時間戳，
             maven-jar-plugin 3.3.0（>= 3.2.0）會據此正規化 entry 順序與時間，
             同一 commit 重複建置的 JAR SHA-256 相同。改版時可一併更新此值。 -->
        <project.build.outputTimestamp>2026-11-04T00:00:00Z</project.build.outputTimestamp>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>8.0.33</version>
        </dependency>
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
            <version>5.1.0</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.3</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>LiTo381-Server</finalName>
        <plugins>
            <!-- 舊 API 只協助 javac；所有成品 JAR 均在下方排除。 -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>compile-only-legacy-stubs</id>
                        <phase>generate-sources</phase>
                        <goals><goal>add-source</goal></goals>
                        <configuration>
                            <sources><source>${project.basedir}/compile-stubs</source></sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <!-- 外掛私有 classpath：不屬於專案 runtime 或 target/lib。 -->
                <dependencies>
                    <dependency>
                        <groupId>org.ow2.asm</groupId>
                        <artifactId>asm</artifactId>
                        <version>9.7</version>
                    </dependency>
                    <dependency>
                        <groupId>org.ow2.asm</groupId>
                        <artifactId>asm-tree</artifactId>
                        <version>9.7</version>
                    </dependency>
                </dependencies>
                <executions>
                    <execution>
                        <id>as-record-main</id>
                        <phase>process-classes</phase>
                        <goals><goal>run</goal></goals>
                        <configuration>
                            <target>
                                <mkdir dir="${project.build.directory}/as-record-tool"/>
                                <javac srcdir="${project.basedir}/tools/as-record/src/main/java"
                                       destdir="${project.build.directory}/as-record-tool"
                                       release="17" encoding="UTF-8" includeantruntime="false">
                                    <classpath refid="maven.plugin.classpath"/>
                                </javac>
                                <java classname="local.lito381.asrecord.AsRecord" fork="true" failonerror="true">
                                    <jvmarg value="-Djava.io.tmpdir=${java.io.tmpdir}"/>
                                    <classpath>
                                        <pathelement location="${project.build.directory}/as-record-tool"/>
                                        <path refid="maven.plugin.classpath"/>
                                    </classpath>
                                    <arg value="${project.build.outputDirectory}"/>
                                </java>
                            </target>
                        </configuration>
                    </execution>
                    <execution>
                        <id>as-record-test</id>
                        <phase>process-test-classes</phase>
                        <goals><goal>run</goal></goals>
                        <configuration>
                            <target xmlns:unless="ant:unless">
                                <java classname="local.lito381.asrecord.AsRecord" fork="true" failonerror="true"
                                      unless:true="${maven.test.skip}">
                                    <jvmarg value="-Djava.io.tmpdir=${java.io.tmpdir}"/>
                                    <classpath>
                                        <pathelement location="${project.build.directory}/as-record-tool"/>
                                        <path refid="maven.plugin.classpath"/>
                                    </classpath>
                                    <arg value="${project.build.testOutputDirectory}"/>
                                </java>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.3.0</version>
                <executions>
                    <execution>
                        <id>as-record-test-fixture</id>
                        <phase>package</phase>
                        <goals><goal>test-jar</goal></goals>
                        <configuration>
                            <classifier>as-record-tests</classifier>
                            <includes><include>local/lito381/server/AsRecordBuildFixture*.class</include></includes>
                        </configuration>
                    </execution>
                    <execution>
                        <id>modern-server</id>
                        <phase>package</phase>
                        <goals><goal>jar</goal></goals>
                        <configuration>
                            <classifier>modern</classifier>
                            <archive>
                                <manifest>
                                    <mainClass>local.lito381.server.ModernStandaloneMain</mainClass>
                                </manifest>
                            </archive>
                        </configuration>
                    </execution>
                </executions>
                <configuration>
                    <excludes>
                        <exclude>com/lineage/**</exclude>
                        <exclude>org/objectweb/asm/**</exclude>
                        <exclude>local/lito381/asrecord/**</exclude>
                    </excludes>
                    <archive>
                        <manifest>
                            <addClasspath>true</addClasspath>
                            <classpathPrefix>lib/</classpathPrefix>
                            <mainClass>local.lito381.server.SharedResourceMain</mainClass>
                        </manifest>
                        <manifestEntries>
                            <Implementation-Version>${project.version}</Implementation-Version>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <id>copy-runtime</id>
                        <phase>package</phase>
                        <goals><goal>copy-dependencies</goal></goals>
                        <configuration>
                            <includeScope>runtime</includeScope>
                            <outputDirectory>${project.build.directory}/lib</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
