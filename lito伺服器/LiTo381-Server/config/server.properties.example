# LiTo 單一外控設定（UTF-8）
# 修改後重啟伺服器／登入器生效。來源清單由資料庫 lito_source_server 管理（最多 8 服）。
# 正式架構固定：來源唯讀、遊戲記憶體運作、僅結算保存 character_lito 勝敗。
# 未知、重複、已退役的設定鍵會拒絕啟動，避免填了卻無效。

# ============================================================
# 一、遊戲設定（連線、資料庫、遊戲規則與管理權限）
# ============================================================

# 登入監聽位址（目前架構限本機回環位址）。
bind=127.0.0.1

# 遊戲監聽位址，必須與 bind 不同；公告位址自動跟隨。
game.bind=127.0.0.2

# 基準埠 1024~65527；來源入口=本值+資料表 source_id，公告埠也使用本值。
port=32000

# LiTo 服務顯示名稱。
server.name=LiTo Standard Arena

# MySQL 主機／埠，例如 jdbc:mysql://localhost:3306/，結尾須有 /。
database.jdbc.base.url=jdbc:mysql://localhost/

# JDBC 連線參數；逾時以毫秒計，避免資料庫失聯時無限等待。
database.jdbc.options=?useUnicode=true&characterEncoding=utf8&connectTimeout=5000&socketTimeout=10000

# 執行帳號：來源及控制表僅 SELECT，character_lito 僅 INSERT/UPDATE。
database.user=lito_shared

# 資料庫密碼；不要分享此檔。Java properties 特殊字元需使用跳脫。
database.password=CHANGE_ME

# 共用靜態庫：武防、技能、NPC 等模板。
database.static.database=380_db

# LiTo 專用控制庫，含 lito_source_server；新增來源請編輯該表，重啟生效。
database.lito.database=380_lito

# 所有來源統一負重倍率，必須 >0 且 <=1000；是倍率，1.0=原公式，100.0=100 倍。
weight.rate=100.0

# ArenaBot 戰鬥 AI 開關（不控制所有 NPC／召喚物 AI）。
battle.ai.enabled=false

# 物理命中計算開關；true 套用命中判斷。
battle.physical.hit.enabled=true

# 戰鬥自然回魔開關。
battle.natural.mp.regen.enabled=true

# 原生攻城模式名單規則開關，只在攻城模式生效。
native.siege.roster.enforced=true

# 返回大廳的固定金幣額度，0~1000000；結算先清除商店物品及本場金幣。
native.tournament.allowance=20000

# 管理權限唯一依據：所選來源動態庫 accounts.access_level；正數為管理員。
# 個別 GM 指令仍須達到 commands.access_level；不提供額外帳號白名單。
# 權限快照於登入後首次使用時讀取；修改資料庫權限後請重新登入。

# ============================================================
# 二、共用 JVM 設定（BAT／登入器皆生效）
# ============================================================

# GUI/BAT JVM 初始記憶體，m 或 g，不得超過最大值。
memory.initial=512m

# GUI/BAT JVM 最大記憶體，m 或 g。
memory.maximum=2048m

# GUI/BAT JVM 可見 CPU 核心數，1~256，不代表獨占。
cpu.limit=4

# ============================================================
# 三、BAT 專用診斷設定
# ============================================================

# BAT 封包紀錄目錄；GUI 每場自動改為該場 outputs/captures，相對 config。
capture.directory=../runtime/captures

# BAT 啟動驗證紀錄目錄，路徑相對 config。
logs.directory=../loginfo

# BAT --smoke 啟動就緒等待秒數，5~300；GUI 另有程序身分與資源就緒檢查。
startup.timeout.seconds=30
